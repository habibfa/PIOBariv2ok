rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'habibfa07@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidTagsList(tags) {
      return tags is list &&
        tags.size() <= 5 &&
        (tags.size() == 0 || (tags[0] is string && tags[0].size() <= 50));
    }

    function isValidSiteReviewCore(data) {
      return data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.role is string && data.role.size() >= 2 && data.role.size() <= 60 &&
        data.institution is string && data.institution.size() >= 1 && data.institution.size() <= 100 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.aspect is string && data.aspect.size() >= 2 && data.aspect.size() <= 80 &&
        isValidTagsList(data.tags) &&
        data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 1200 &&
        data.createdAt is timestamp &&
        data.helpfulCount is int && data.helpfulCount >= 0 && data.helpfulCount <= 1000000 &&
        data.verified is bool && data.verified == true &&
        data.isPublic is bool && data.isPublic == true;
    }

    function isValidSiteReviewCreate(data) {
      return data.keys().hasAll([
          'authorName', 'role', 'institution', 'rating', 'aspect',
          'tags', 'comment', 'createdAt', 'helpfulCount', 'verified', 'isPublic'
        ]) &&
        data.keys().hasOnly([
          'authorName', 'role', 'institution', 'rating', 'aspect',
          'tags', 'comment', 'createdAt', 'helpfulCount', 'verified', 'isPublic'
        ]) &&
        isValidSiteReviewCore(data) &&
        data.createdAt == request.time &&
        data.helpfulCount == 0;
    }

    function isValidSiteReviewUpdate(data) {
      return data.keys().hasAll([
          'authorName', 'role', 'institution', 'rating', 'aspect',
          'tags', 'comment', 'createdAt', 'helpfulCount', 'verified', 'isPublic'
        ]) &&
        data.keys().hasOnly([
          'authorName', 'role', 'institution', 'rating', 'aspect',
          'tags', 'comment', 'createdAt', 'helpfulCount', 'verified', 'isPublic',
          'adminReplyText', 'adminRepliedBy', 'adminRepliedAt'
        ]) &&
        isValidSiteReviewCore(data) &&
        (!('adminReplyText' in data) || (data.adminReplyText is string && data.adminReplyText.size() >= 1 && data.adminReplyText.size() <= 1000)) &&
        (!('adminRepliedBy' in data) || (data.adminRepliedBy is string && data.adminRepliedBy.size() >= 2 && data.adminRepliedBy.size() <= 100)) &&
        (!('adminRepliedAt' in data) || data.adminRepliedAt is timestamp);
    }

    function isHelpfulVoteAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount']) &&
        incoming().helpfulCount == existing().helpfulCount + 1 &&
        incoming().createdAt == existing().createdAt;
    }

    function isAdminReplyAction() {
      return isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['adminReplyText', 'adminRepliedBy', 'adminRepliedAt']) &&
        incoming().createdAt == existing().createdAt &&
        incoming().adminRepliedAt == request.time;
    }

    // --- Collection: /site_reviews/{reviewId} ---
    match /site_reviews/{reviewId} {
      // Public site reviews are readable by all PIOBARI visitors
      allow get: if isValidId(reviewId) && existing().isPublic == true;
      allow list: if existing().isPublic == true;

      // Public visitors can submit real-time non-anonymous site reviews with strict schema & timestamp enforcement
      allow create: if isValidId(reviewId) && isValidSiteReviewCreate(incoming());

      // Action-based updates: public +1 helpful upvote OR verified admin official reply
      allow update: if isValidId(reviewId) && isValidSiteReviewUpdate(incoming()) && (
        isHelpfulVoteAction() ||
        isAdminReplyAction()
      );

      // Only verified administrators can delete reviews
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // --- Collection: /admins/{userId} ---
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isAdmin() &&
        incoming().keys().hasAll(['role', 'createdAt']) &&
        incoming().keys().hasOnly(['role', 'createdAt']) &&
        incoming().role == 'admin' &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
